    "settings.accounts.connected-count": {
      "comment": "Summary showing number of connected accounts",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@ connected account"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "d",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d connected account"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%d connected accounts"
                    }
                  }
                }
              }
            }
          }
        }
      }
